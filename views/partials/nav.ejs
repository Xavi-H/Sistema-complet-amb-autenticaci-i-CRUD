<nav>
    <a href="/">Inici</a>
    <% if (user) { %>
        | <a href="/protected">Zona privada</a>
        | <a href="/profile">Perfil</a>
        | <a href="/pokemons">Pokemons</a>
        <% if (user.role === "admin") { %>
            | <a href="/users">Users</a>
        <% } %>
