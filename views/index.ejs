        <p>Hola <%= user.username %>! Ja has iniciat sessió.</p>
        <p><a href="/pokemons">Veure els pokemons</a></p>
    <% } else { %>
        <p>Inicia sessió o registra't per gestionar els books.</p>
        <p><a href="/login">Entrar / Registrar-se</a></p>
    <% } %>
</body>
</html>
