<!DOCTYPE html>
<html lang="ca">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cartes Pokémon</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <%- include('partials/nav') %>
    <h1>Cartes Pokémon</h1>
    <p><a href="/pokemons/new">Afegir una carta nova</a></p>

    <% if (pokemons.length === 0) { %>
        <p>No hi ha cap carta.</p>
    <% } else { %>
        <ul>
            <% pokemons.forEach(pokemon => { %>
                <li>
                    <strong><%= pokemon.name %></strong>
                    - Tipus: <%= pokemon.Tipus %>
                    - Creat per: <%= pokemon.ownerName ?? "Sense propietari" %>
                    - <a href="/pokemons/<%= pokemon.id %>">Veure</a>
                    <% if (user.role === "admin" || pokemon.ownerId === user.id) { %>
                        - <a href="/pokemons/<%= pokemon.id %>/edit">Editar</a>
                        <form action="/pokemons/<%= pokemon.id %>?_method=DELETE" method="POST">
                            <button type="submit">Eliminar</button>
                        </form>
                    <% } %>
                </li>
            <% }) %>
        </ul>
    <% } %>
</body>
</html>
