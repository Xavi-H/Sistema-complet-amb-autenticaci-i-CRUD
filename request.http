@host = http://localhost:3000

### Login (guarda el token per a les peticions següents)
# @name login
POST {{host}}/login
Content-Type: application/json

{
  "username": "xavi",
  "password": "123456"
}

###
@token = {{login.response.body.token}}

###  POKEMONS 
GET {{host}}/pokemons
Accept: application/json
Authorization: Bearer {{token}}

###
GET {{host}}/pokemons/2
Accept: application/json
Authorization: Bearer {{token}}

###
POST {{host}}/pokemons
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Squirtle",
  "Tipus": "Agua"
}

###
PUT {{host}}/pokemons/5
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Squirtle",
  "Tipus": "Agua/Tierra"
}

###
DELETE {{host}}/pokemons/5
Accept: application/json
Authorization: Bearer {{token}}

###  USERS (només admin) 
GET {{host}}/users
Accept: application/json
Authorization: Bearer {{token}}

###
POST {{host}}/users
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "username": "maria",
  "password": "maria123",
  "role": "user"
}

### Sense token -> 401
GET {{host}}/pokemons
Accept: application/json
